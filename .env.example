# Copy this file to .env and paste your Jev key once. Never commit .env.
JEV_API_KEY=
# Set to jev to require live Jev judgment. A missing key fails startup.
SAFETY_EVALUATOR=local
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=20000

# Default upstream is the installed official Filesystem MCP, restricted to the
# temporary demo folder created by npm run demo. Override with your own server:
# UPSTREAM_COMMAND=node
# UPSTREAM_ARGS=["C:/path/to/existing-mcp-server.js"]
# UPSTREAM_CWD=C:/path/to/server
# UPSTREAM_ENV={"SERVICE_TOKEN":"local-secret"}
# For an already prepared directory instead of the temporary demo:
# MCP_DEMO_DIR=C:/mcp-demo

# Prefer trusted host configuration for real integrations. Otherwise call
# set_user_intent once; it locks until the gateway session is restarted.
# GATEWAY_ORIGINAL_INTENT=Read report.txt and summarize it. Do not modify files.
# Optional local browser approval console (0 chooses an available loopback port).
# REVIEW_PORT=0
# REVIEW_TTL_MS=300000
GATEWAY_AGENT_ID=demo-agent
GATEWAY_WORKFLOW_ID=demo-workflow
# AUDIT_LOG_PATH=audit/audit-log.jsonl
# Estimates for demo reporting, not measured provider charges:
LOCAL_ESTIMATE_USD=0.0001
JEV_ESTIMATE_USD=0.0015
UPSTREAM_TOOL_ESTIMATE_USD=0
