{
  "name": "intent-safety-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal intent-aware safety gateway for MCP tools",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "demo": "npm run build && node --env-file-if-exists=.env demo.mjs",
    "live-demo": "npm run build && node --env-file-if-exists=.env live-demo.mjs",
    "audit-report": "npm run build && node audit-report.mjs",
    "jev-test": "npm run build && node --env-file-if-exists=.env jev-test.mjs",
    "test": "npm run build && node --env-file-if-exists=.env --test test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
